# Server
NODE_ENV=development
PORT=3001

# Database
# Use DATABASE_URL for Render PostgreSQL or Supabase PostgreSQL.
# Leave it blank for local development with the individual DB_* settings below.
DATABASE_URL=
# Leave DB_SSL blank to auto-enable SSL for production DATABASE_URL connections.
# Set DB_SSL=false only for a local/non-SSL database.
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibayad_payroll
DB_USER=postgres
DB_PASSWORD=change_me

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Account activation
ACCOUNT_ACTIVATION_EXPIRES_HOURS=72

# One-time admin bootstrap; not required at runtime.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_temporary_12_character_password

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=your_smtp_password_here
SMTP_FROM="iBayad Payroll <noreply@example.com>"
