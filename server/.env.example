# Server
NODE_ENV=development
PORT=3001

# Database
# Use DATABASE_URL for Render PostgreSQL or Supabase PostgreSQL.
# Leave it blank for local development with the individual DB_* settings below.
DATABASE_URL=
# Leave DB_SSL blank to auto-enable SSL for production DATABASE_URL connections.
# Set DB_SSL=false only for a local/non-SSL database.
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibayad_payroll
DB_USER=postgres
DB_PASSWORD=change_me

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Account activation
ACCOUNT_ACTIVATION_EXPIRES_HOURS=72
PASSWORD_RESET_EXPIRES_MINUTES=60

# Login brute-force protection; local/demo in-memory limiter.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_BLOCK_MINUTES=5

# One-time admin bootstrap; not required at runtime.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_temporary_12_character_password

# Email (Resend)
# In production, set RESEND_API_KEY, EMAIL_FROM, and CLIENT_URL in the deployment environment.
# Never commit real Resend API keys.
# Email Provider
EMAIL_PROVIDER=resend
REQUIRE_EMAIL_READY=false
RESEND_API_KEY=true_api_key_here
EMAIL_FROM="iBayad Payroll <noreply@your-domain.com>"
EMAIL_SEND_RETRIES=2
EMAIL_RETRY_DELAY_MS=1000
