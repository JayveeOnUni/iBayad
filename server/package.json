{
  "name": "ibayad-payroll-server",
  "version": "1.0.0",
  "description": "iBayad Payroll Management System API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "db:migrate": "node scripts/migrate.js",
    "admin:create": "node scripts/create-admin.js",
    "seed:demo-account": "node scripts/seed-demo-employee-account.js",
    "seed:demo-employee": "node scripts/run-sql-file.js src/db/seed-demo-employee-attendance.sql",
    "seed:demo-payroll-specialist": "node scripts/run-sql-file.js src/db/seed-demo-payroll-specialist-18m.sql",
    "test": "node --test -r ts-node/register/transpile-only tests/*.test.ts",
    "test:add-employee": "node --test -r ts-node/register/transpile-only tests/employeeController.addEmployee.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "resend": "^6.12.3",
    "typescript": "^5.9.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
